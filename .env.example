# Copie este arquivo para ".env" e preencha com seus próprios valores.
# O projeto.py carrega essas variáveis automaticamente via python-dotenv.
#
# ATENÇÃO: nunca faça commit do arquivo ".env" real — ele já está listado
# no .gitignore.

# Conta de e-mail (Gmail) usada para enviar os resultados aos alunos.
EMAIL_REMETENTE=SEU_EMAIL_AQUI@gmail.com

# Senha de app do Gmail (NÃO é a senha normal da conta).
# Gere uma em: https://myaccount.google.com/apppasswords
# (é necessário ter a verificação em duas etapas ativada)
EMAIL_SENHA_APP=SUA_SENHA_DE_APP_AQUI
